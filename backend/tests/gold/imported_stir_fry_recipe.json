    "instructions": [
        {
            "step_number": 1,
            "instruction": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat. ½ cup basmati rice 1 cup water",
            "ingredient_names": [
                "basmati rice"
            ]
        },
        {
            "step_number": 2,
            "instruction": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
            "ingredient_names": []
        },
        {
            "step_number": 3,
            "instruction": "Meanwhile, wash and dry the fresh produce. (1 inch) piece ginger root 2 green bell peppers ½ small bunch green onions (scallions)",
            "ingredient_names": [
                "(1 inch) piece ginger root",
                "green bell peppers",
                "small bunch green onions (scallions)"
            ]
        },
        {
            "step_number": 4,
            "instruction": "Peel and mince ginger. Peel and mince garlic. 2 cloves garlic",
            "ingredient_names": [
                "garlic"
            ]
        },
        {
            "step_number": 5,
            "instruction": "Place soy sauce, oil, cornstarch, vinegar, and sugar in a small bowl; whisk to combine the sauce. ¼ cup soy sauce 1 tbsp toasted sesame oil 2 tsp cornstarch ½ tsp rice vinegar ½ tsp brown sugar",
            "ingredient_names": [
                "brown sugar",
                "cornstarch",
                "rice vinegar",
                "soy sauce",
                "toasted sesame oil"
            ]
        },
        {
            "step_number": 6,
            "instruction": "Seed and medium dice bell peppers.",
            "ingredient_names": []
        },
        {
            "step_number": 7,
            "instruction": "Cut chicken thighs into ½-inch pieces. 1 lb chicken thighs, boneless skinless",
            "ingredient_names": [
                "chicken thighs, boneless skinless"
            ]
        },
        {
            "step_number": 8,
            "instruction": "Heat a large skillet over high heat.",
            "ingredient_names": []
        },
        {
            "step_number": 9,
            "instruction": "Once the skillet is hot, add oil and swirl to coat the bottom. 1 tsp toasted sesame oil",
            "ingredient_names": [
                "toasted sesame oil"
            ]
        },
        {
            "step_number": 10,
            "instruction": "Add chicken and stir-fry for 2-3 minutes. Add ginger, garlic, and bell peppers; continue to cook, stirring often, until veggies begin to soften, 2-3 more minutes.",
            "ingredient_names": [
                "garlic"
            ]
        },
        {
            "step_number": 11,
            "instruction": "Pour sauce into the skillet. Reduce heat to medium-high and cook, stirring often, until the sauce thickens, 4-5 minutes.",
            "ingredient_names": []
        },
        {
            "step_number": 12,
            "instruction": "Meanwhile, trim green onions on a clean cutting board and cut crosswise into ¼-inch pieces.",
            "ingredient_names": []
        },
        {
            "step_number": 13,
            "instruction": "Add cashews to the skillet and stir to combine. ¼ cup cashews, roasted unsalted",
            "ingredient_names": [
                "cashews, roasted unsalted"
            ]
        },
        {
            "step_number": 14,
            "instruction": "To serve, divide rice between bowls; top with chicken stir-fry and green onions. Enjoy!",
            "ingredient_names": []
        }
